---
import Button from "./Button.astro";

interface Props {
  action?: string;
}

const {
  action = "https://formspree.io/f/your-id",
} = Astro.props;
---

<form
  class="contact-form"
  action={action}
  method="POST"
  novalidate
  data-form
>
  <div class="field">
    <label for="cf-name">
      Nombre <span aria-hidden="true">*</span>
    </label>
    <input
      id="cf-name"
      name="name"
      type="text"
      autocomplete="name"
      required
      aria-describedby="cf-name-err"
    />
    <p class="field-error" id="cf-name-err" hidden></p>
  </div>

  <div class="field">
    <label for="cf-email">
      Email <span aria-hidden="true">*</span>
    </label>
    <input
      id="cf-email"
      name="email"
      type="email"
      autocomplete="email"
      required
      aria-describedby="cf-email-err"
    />
    <p class="field-error" id="cf-email-err" hidden></p>
  </div>

  <div class="field">
    <label for="cf-phone">
      Teléfono <span class="field-optional">(opcional)</span>
    </label>
    <input
      id="cf-phone"
      name="phone"
      type="tel"
      autocomplete="tel"
      inputmode="tel"
      aria-describedby="cf-phone-err"
    />
    <p class="field-error" id="cf-phone-err" hidden></p>
  </div>

  <div class="field">
    <label for="cf-zone">
      Zona de la casa <span class="field-optional">(opcional)</span>
    </label>
    <input
      id="cf-zone"
      name="zone"
      type="text"
      autocomplete="off"
      placeholder="Ej. Cadaqués, Llançà, interior del Empordà…"
    />
  </div>

  <div class="field field-full">
    <label for="cf-message">
      Cuéntanos qué necesitas <span aria-hidden="true">*</span>
    </label>
    <textarea
      id="cf-message"
      name="message"
      rows="4"
      required
      aria-describedby="cf-message-err"
    ></textarea>
    <p class="field-error" id="cf-message-err" hidden></p>
  </div>

  <div class="field-full form-actions">
    <button type="submit" class="form-submit" data-submit>
      <span data-submit-label>Enviar mensaje</span>
      <span class="form-spinner" data-submit-spinner aria-hidden="true"></span>
    </button>
    <p class="form-status" data-status role="status" aria-live="polite"></p>
  </div>

  <div class="form-success" data-success hidden>
    <p class="form-success-title">Mensaje enviado.</p>
    <p class="form-success-text">
      Gracias. Te respondemos en menos de 24h.
    </p>
  </div>
</form>

<style>
  .contact-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .field-full {
    grid-column: 1 / -1;
  }
  label {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-primary);
  }
  .field-optional {
    color: var(--text-muted);
    font-weight: 400;
  }
  input,
  textarea {
    width: 100%;
    padding: 0.75rem var(--space-md);
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--text-primary);
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    transition: border-color var(--motion-base), box-shadow var(--motion-base);
  }
  input::placeholder,
  textarea::placeholder {
    color: var(--text-muted);
    opacity: 0.7;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: var(--ring-focus);
  }
  textarea {
    resize: vertical;
    min-height: 6rem;
  }
  .field-error {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--error);
  }
  .field[data-invalid] input,
  .field[data-invalid] textarea {
    border-color: var(--error);
  }

  .form-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }
  .form-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: 0.875rem 1.75rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1;
    color: var(--color-white);
    background: var(--color-petrol);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--motion-base), box-shadow var(--motion-base), transform var(--motion-fast);
  }
  .form-submit:hover {
    background: var(--color-petrol-deep);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }
  .form-submit:disabled {
    opacity: 0.6;
    pointer-events: none;
  }
  .form-spinner {
    display: none;
    width: 1rem;
    height: 1rem;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: var(--color-white);
    border-radius: var(--radius-circle);
    animation: spin 0.8s linear infinite;
  }
  .form-submit[data-loading="true"] .form-spinner {
    display: inline-block;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .form-spinner { animation: none; }
    .form-submit:hover { transform: none; }
  }

  .form-status {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .form-status[data-state="error"] {
    color: var(--error);
  }

  .form-success {
    grid-column: 1 / -1;
    padding: var(--space-lg);
    border: 1px solid rgba(107, 143, 113, 0.32);
    border-radius: var(--radius-md);
    background: rgba(107, 143, 113, 0.08);
  }
  .form-success-title {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text-primary);
  }
  .form-success-text {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  @media (min-width: 640px) {
    .contact-form {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-form]");
  if (form) {
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
    const label = form.querySelector<HTMLElement>("[data-submit-label]");
    const status = form.querySelector<HTMLElement>("[data-status]");
    const success = form.querySelector<HTMLElement>("[data-success]");

    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const setErr = (id: string, msg: string | null) => {
      const field = form.querySelector<HTMLElement>(`#cf-${id}`)?.closest<HTMLElement>(".field");
      const err = form.querySelector<HTMLElement>(`#cf-${id}-err`);
      if (!field || !err) return;
      if (msg) {
        field.setAttribute("data-invalid", "");
        err.textContent = msg;
        err.hidden = false;
      } else {
        field.removeAttribute("data-invalid");
        err.textContent = "";
        err.hidden = true;
      }
    };

    const validate = () => {
      let ok = true;
      const name = form.querySelector<HTMLInputElement>("#cf-name")!;
      const email = form.querySelector<HTMLInputElement>("#cf-email")!;
      const message = form.querySelector<HTMLTextAreaElement>("#cf-message")!;

      if (!name.value.trim()) { setErr("name", "Dinos tu nombre."); ok = false; }
      else setErr("name", null);

      if (!email.value.trim()) { setErr("email", "Necesitamos tu email."); ok = false; }
      else if (!emailRe.test(email.value.trim())) { setErr("email", "Email no válido."); ok = false; }
      else setErr("email", null);

      if (!message.value.trim()) { setErr("message", "Cuéntanos algo."); ok = false; }
      else setErr("message", null);

      return ok;
    };

    const fields = form.querySelectorAll<HTMLElement>("input, textarea");
    fields.forEach((f) => {
      f.addEventListener("blur", () => {
        const id = f.id.replace("cf-", "");
        if (id === "name" || id === "email" || id === "message") {
          const err = form.querySelector<HTMLElement>(`#cf-${id}-err`);
          if (err && !err.hidden) validate();
          else if (f.value.trim()) {
            if (id === "email" && !emailRe.test(f.value.trim())) setErr("email", "Email no válido.");
            else setErr(id, null);
          }
        }
      });
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      status?.removeAttribute("data-state");
      status!.textContent = "";
      if (!validate()) {
        status!.textContent = "Revisa los campos marcados.";
        status?.setAttribute("data-state", "error");
        return;
      }
      submit!.setAttribute("data-loading", "true");
      submit!.disabled = true;
      if (label) label.textContent = "Enviando…";

      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (res.ok) {
          form.hidden = true;
          if (success) success.hidden = false;
        } else {
          throw new Error("Bad response");
        }
      } catch {
        status!.textContent = "Algo ha fallado. Inténtalo de nuevo o escríbenos a hola@happyhomes.cat.";
        status?.setAttribute("data-state", "error");
        submit!.removeAttribute("data-loading");
        submit!.disabled = false;
        if (label) label.textContent = "Enviar mensaje";
      }
    });
  }
</script>
