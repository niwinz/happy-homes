---
interface Props {
  tone?: "neutral" | "accent" | "success" | "warning" | "error";
  class?: string;
}

const { tone = "neutral", class: className } = Astro.props;
---

<span class:list={["pill", `pill--${tone}`, className]}>
  <slot />
</span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.25rem 0.625rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.4;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .pill--neutral {
    background: rgba(26, 58, 74, 0.06);
    color: var(--text-primary);
    border-color: var(--border-default);
  }
  .pill--accent {
    background: rgba(199, 107, 76, 0.1);
    color: var(--accent-text);
    border-color: rgba(199, 107, 76, 0.24);
  }
  .pill--success {
    background: rgba(107, 143, 113, 0.12);
    color: var(--success);
    border-color: rgba(107, 143, 113, 0.28);
  }
  .pill--warning {
    background: rgba(201, 162, 74, 0.14);
    color: var(--warning);
    border-color: rgba(201, 162, 74, 0.3);
  }
  .pill--error {
    background: rgba(177, 75, 58, 0.1);
    color: var(--error);
    border-color: rgba(177, 75, 58, 0.24);
  }
</style>
