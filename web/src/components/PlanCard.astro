---
import Card from "./Card.astro";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import Pill from "./Pill.astro";

interface Plan {
  name: string;
  price: string;
  period?: string;
  blurb: string;
  features: string[];
  featured?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
  badge?: string;
}

interface Props {
  plan: Plan;
}

const {
  plan: {
    name,
    price,
    period = "/mes",
    blurb,
    features,
    featured = false,
    ctaLabel = "Empezar",
    ctaHref = "/contacto",
    badge,
  },
} = Astro.props;
---

<Card as="article" pad="lg" bordered featured={featured} class="plan">
  <div class="plan-head">
    <h3 class="plan-name">{name}</h3>
    {badge && <Pill tone="accent">{badge}</Pill>}
  </div>
  <div class="plan-price">
    <span class="plan-amount">{price}</span>
    <span class="plan-period">{period}</span>
  </div>
  <p class="plan-blurb">{blurb}</p>
  <ul class="plan-features">
    {
      features.map((f) => (
        <li>
          <span class="plan-check" aria-hidden="true">
            <Icon name="check" size={16} />
          </span>
          <span>{f}</span>
        </li>
      ))
    }
  </ul>
  <div class="plan-cta">
    <Button
      href={ctaHref}
      variant={featured ? "primary" : "outline"}
      size="md"
      class="plan-btn"
    >
      {ctaLabel}
    </Button>
  </div>
</Card>

<style>
  .plan {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
  }
  .plan-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .plan-name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--text-primary);
  }
  .plan-price {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }
  .plan-amount {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  .plan-period {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .plan-blurb {
    margin: var(--space-sm) 0 var(--space-lg);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .plan-features {
    list-style: none;
    margin: 0 0 var(--space-xl);
    padding: 0;
    display: grid;
    gap: var(--space-sm);
    flex: 1;
  }
  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-primary);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .plan-features li > span:not(.plan-check) {
    min-width: 0;
    flex: 1 1 auto;
  }
  .plan-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.125rem;
    border-radius: var(--radius-circle);
    background: rgba(107, 143, 113, 0.16);
    color: var(--success);
  }
  .plan-cta {
    margin-top: auto;
  }
  .plan-btn {
    width: 100%;
  }
</style>
