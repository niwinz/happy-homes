---
import Icon from "./Icon.astro";

interface Props {
  languages: string[];
}

const { languages } = Astro.props;
---

<div class="languages" data-reveal>
  <div class="languages-icon" aria-hidden="true">
    <Icon name="globe" size={22} />
  </div>
  <div class="languages-body">
    <p class="languages-eyebrow">Hablamos tu idioma</p>
    <ul class="languages-list">
      {languages.map((l) => <li>{l}</li>)}
    </ul>
  </div>
</div>

<style>
  .languages {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    padding: var(--space-lg);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--bg-card);
  }
  .languages-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    background: rgba(199, 107, 76, 0.1);
    color: var(--accent);
  }
  .languages-eyebrow {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .languages-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    min-width: 0;
  }
  .languages-list li {
    font-size: 0.9375rem;
    color: var(--text-primary);
    padding-inline-end: var(--space-sm);
    border-inline-end: 1px solid var(--border-default);
    overflow-wrap: anywhere;
  }
  .languages-list li:last-child {
    border-inline-end: 0;
    padding-inline-end: 0;
  }
</style>
