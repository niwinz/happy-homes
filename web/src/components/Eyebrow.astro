---
interface Props {
  as?: "p" | "span" | "div";
  class?: string;
}

const { as: Tag = "p", class: className } = Astro.props;
---

<Tag class:list={["eyebrow", className]}>
  <slot />
</Tag>

<style>
  .eyebrow {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-body);
    font-size: 0.75rem;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
