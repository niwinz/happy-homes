---
import Container from "./Container.astro";
import Button from "./Button.astro";

const nav = [
  { href: "/servicios", label: "Servicios" },
  { href: "/como-funciona", label: "Cómo funciona" },
  { href: "/el-informe", label: "El informe" },
  { href: "/sobre-nosotros", label: "Sobre nosotros" },
  { href: "/faq", label: "FAQ" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header">
  <Container>
    <div class="bar">
      <a class="wordmark" href="/" aria-label="HappyHomes — inicio">
        <img
          class="wordmark-symbol"
          src="/brand/happyhomes-symbol.svg"
          width="844"
          height="724"
          alt=""
          aria-hidden="true"
        />
        <span>HappyHomes</span>
      </a>

      <nav class="nav-desktop" aria-label="Principal">
        {
          nav.map((item) => (
            <a
              class:list={["nav-link", { active: isActive(item.href) }]}
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="cta-desktop">
        <Button href="/contacto" variant="primary" size="sm">
          Comprobar disponibilidad
        </Button>
      </div>

      <details class="nav-mobile">
        <summary aria-label="Abrir menú">
          <span class="burger" aria-hidden="true"></span>
        </summary>
        <nav class="nav-mobile-menu" aria-label="Principal móvil">
          {
            nav.map((item) => (
              <a
                class:list={["nav-link", { active: isActive(item.href) }]}
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <Button href="/contacto" variant="primary" size="sm" class="mobile-cta">
            Comprobar disponibilidad
          </Button>
        </nav>
      </details>
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--color-white) 88%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--border-default);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 4rem;
  }

  .wordmark {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.05em;
    color: var(--color-petrol);
    text-decoration: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
  }

  .wordmark-symbol {
    display: block;
    width: auto;
    height: 2.25rem;
    flex: none;
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: clamp(var(--space-sm), 2vw, var(--space-xl));
  }

  .cta-desktop {
    display: none;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
    padding-block: var(--space-sm);
    padding-inline: var(--space-sm);
    min-height: 44px;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
    border-bottom: 2px solid transparent;
    transition:
      color var(--motion-base),
      border-color var(--motion-base);
  }
  .nav-link:hover {
    color: var(--accent-text);
  }
  .nav-link.active {
    border-bottom-color: var(--accent-text);
    color: var(--accent-text);
  }

  .nav-mobile {
    position: relative;
  }
  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }
  .burger {
    display: block;
    width: 1.5rem;
    height: 2px;
    background: var(--color-petrol);
    box-shadow:
      0 5px 0 0 var(--color-petrol),
      0 -5px 0 0 var(--color-petrol);
    border-radius: 2px;
  }
  .nav-mobile-menu {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-sm));
    min-width: 14rem;
    max-width: calc(100vw - var(--space-lg) * 2);
    background: var(--color-white);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: var(--space-md);
    overflow-wrap: anywhere;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .mobile-cta {
    margin-top: var(--space-sm);
    width: 100%;
  }

  @media (min-width: 1180px) {
    .nav-mobile {
      display: none;
    }
    .nav-desktop {
      display: flex;
    }
    .cta-desktop {
      display: inline-flex;
    }
  }
</style>
