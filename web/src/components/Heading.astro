---
interface Props {
  level?: 1 | 2 | 3 | 4;
  size?: "display" | "h1" | "h2" | "h3" | "h4";
  class?: string;
}

const { level = 2, size, class: className } = Astro.props;
const Tag = `h${level}` as const;
const sizeClass = size ?? `h${level}`;
---

<Tag class:list={["heading", `heading--${sizeClass}`, className]}>
  <slot />
</Tag>

<style>
  .heading {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.15;
  }
  .heading--display {
    font-size: clamp(3.25rem, 6vw, 4rem);
    line-height: 1.1;
  }
  .heading--h1 {
    font-size: clamp(2.25rem, 4vw, 2.5rem);
  }
  .heading--h2 {
    font-size: clamp(1.75rem, 3vw, 2rem);
    line-height: 1.2;
  }
  .heading--h3 {
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .heading--h4 {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.4;
  }
</style>
