---
import Container from "./Container.astro";
import SectionHead from "./SectionHead.astro";

interface Row {
  feature: string;
  lite: string;
  care: string;
  complete: string;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---

<section class="comparison" aria-labelledby="comparison-title">
  <Container>
    <SectionHead
      eyebrow="Comparación"
      heading="Qué incluye cada plan."
      lead="El protocolo base no cambia. Aquí puedes comparar frecuencia, coordinación y servicios que se presupuestan aparte."
    />
    <div
      class="table-scroll"
      role="region"
      aria-label="Comparación detallada de planes"
      tabindex="0"
    >
      <table>
        <caption id="comparison-title">Comparación de Lite, Care y Complete</caption>
        <thead>
          <tr>
            <th scope="col">Prestación</th>
            <th scope="col">Lite</th>
            <th scope="col" class="recommended">Care <span>Recomendado</span></th>
            <th scope="col">Complete</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row">{row.feature}</th>
              <td>{row.lite}</td>
              <td class="recommended">{row.care}</td>
              <td>{row.complete}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="scroll-note">En pantallas pequeñas, desplaza la tabla horizontalmente para comparar.</p>
  </Container>
</section>

<style>
  .comparison {
    padding-block: clamp(4rem, 8vw, 6rem);
    background: var(--bg-page);
  }
  .table-scroll {
    margin-top: var(--space-2xl);
    overflow-x: auto;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--bg-card);
  }
  .table-scroll:focus-visible {
    outline: none;
    box-shadow: var(--ring-focus);
  }
  table {
    width: 100%;
    min-width: 48rem;
    border-collapse: collapse;
    color: var(--text-primary);
  }
  caption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  th,
  td {
    padding: var(--space-md);
    border-bottom: 1px solid var(--border-default);
    text-align: left;
    vertical-align: top;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  thead th {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    background: var(--bg-section);
  }
  thead th span {
    display: block;
    margin-top: var(--space-xs);
    color: var(--accent-text);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  tbody th {
    width: 28%;
    font-weight: 500;
  }
  tbody td {
    color: var(--text-muted);
  }
  tr:last-child th,
  tr:last-child td {
    border-bottom: 0;
  }
  .recommended {
    background: color-mix(in srgb, var(--accent) 7%, var(--bg-card));
  }
  .scroll-note {
    margin: var(--space-sm) 0 0;
    color: var(--text-muted);
    font-size: 0.75rem;
  }
  @media (min-width: 768px) {
    .scroll-note {
      display: none;
    }
  }
</style>
