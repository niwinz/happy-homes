---
interface Props {
  as?: "div" | "section" | "header" | "footer" | "article" | "nav";
  class?: string;
}

const { as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["container", className]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-lg);
  }
</style>
