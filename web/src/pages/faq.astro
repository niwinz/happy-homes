---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import CtaBand from "../components/CtaBand.astro";
import Section from "../components/Section.astro";
import { faqGroups } from "../data/product";
---

<Base
  title="Preguntas frecuentes — HappyHomes"
  description="Resolvemos dudas sobre planes, visitas, protocolo, informes, vídeo, llaves, incidencias y servicios adicionales."
>
  <Hero
    eyebrow="Preguntas frecuentes"
    title="Lo importante, explicado antes de entrar en tu casa."
    lead="Planes, alcance, evidencia, llaves e incidencias. Si algo depende de tu vivienda, te lo confirmamos antes de activar el servicio."
    primaryCta={{ label: "Comprobar disponibilidad", href: "/contacto" }}
    secondaryCta={{ label: "Cómo funciona", href: "/como-funciona" }}
  />

  <Section>
    <FaqAccordion groups={faqGroups} />
  </Section>

  <CtaBand
    heading="¿Tu caso necesita una respuesta más concreta?"
    lead="Cuéntanos el municipio, el tipo de casa y qué necesitas. Revisamos cobertura y encaje contigo."
    ctaLabel="Comprobar disponibilidad"
    ctaHref="/contacto"
    secondaryLabel="Ver planes y extras"
    secondaryHref="/servicios"
  />
</Base>
