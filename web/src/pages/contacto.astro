---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ContactForm from "../components/ContactForm.astro";
import Coverage from "../components/Coverage.astro";
import Section from "../components/Section.astro";
import Icon from "../components/Icon.astro";
import Card from "../components/Card.astro";

const zones = [
  "Olot",
  "Costa Brava",
  "Alt Empordà",
  "De Llançà a Tossa de Mar",
  "Figueres",
  "Besalú",
  "Banyoles",
  "Interior del Empordà",
];

const info = [
  {
    icon: "mail",
    label: "Email",
    value: "hola@happyhomes.cat",
    href: "mailto:hola@happyhomes.cat",
  },
  {
    icon: "phone",
    label: "Teléfono / WhatsApp",
    value: "+34 XXX XXX XXX",
    note: "Disponible también para urgencias si ya eres cliente",
  },
  {
    icon: "clock",
    label: "Horario",
    value: "Lunes a viernes · 9:00 – 19:00",
    note: "Urgencias 24h para clientes con plan Premium",
  },
  {
    icon: "mapPin",
    label: "Presencial",
    value: "Olot · Alt Empordà",
    note: "Quedamos donde te vaya bien: en tu casa, en un café o por videollamada si estás fuera.",
  },
];

const languages = ["Castellano", "Catalán", "Francés", "Inglés", "Alemán"];
---

<Base
  title="Contacto — HappyHomes"
  description="Ponte en contacto con HappyHomes para el cuidado de tu segunda residencia en la Costa Brava y el Alt Empordà."
>
  <Hero
    eyebrow="Contacto"
    title="Háblanos de tu casa."
    lead="Cuéntanos dónde está, qué usos tiene y qué necesitas. Te recomendamos el plan que mejor encaje sin compromiso."
  />

  <Section>
    <div class="contact-grid">
      <div class="contact-form-wrap" data-reveal>
        <h2 class="block-title">Cuéntanos qué necesitas</h2>
        <ContactForm />
      </div>

      <div class="contact-aside" data-reveal>
        <h2 class="block-title">O si prefieres, directo</h2>
        <div class="info-list">
          {
            info.map((item) => (
              <Card as="div" pad="md" bordered class="info-card">
                <span class="info-icon" aria-hidden="true">
                  <Icon name={item.icon} size={20} />
                </span>
                <div class="info-body">
                  <p class="info-label">{item.label}</p>
                  {item.href ? (
                    <a class="info-value" href={item.href}>{item.value}</a>
                  ) : (
                    <p class="info-value">{item.value}</p>
                  )}
                  {item.note && <p class="info-note">{item.note}</p>}
                </div>
              </Card>
            ))
          }
        </div>

        <div class="aside-block">
          <p class="aside-eyebrow">Hablamos tu idioma</p>
          <ul class="lang-list">
            {languages.map((l) => <li>{l}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="dark">
    <div class="coverage-dark" data-reveal>
      <h2 class="coverage-title">Zona de cobertura</h2>
      <ul class="coverage-zones">
        {zones.map((z) => <li>{z}</li>)}
      </ul>
      <p class="coverage-note">
        ¿Estás fuera de esta zona? Escríbenos igualmente. A veces podemos llegar
        a acuerdos especiales.
      </p>
    </div>
  </Section>
</Base>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-2xl);
  }
  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-3xl);
      align-items: start;
    }
  }
  .block-title {
    margin: 0 0 var(--space-lg);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .info-list {
    display: grid;
    gap: var(--space-md);
  }
  .info-card {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }
  .info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    background: rgba(199, 107, 76, 0.1);
    color: var(--accent-text);
  }
  .info-body {
    flex: 1;
  }
  .info-label {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .info-value {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
  }
  a.info-value:hover {
    color: var(--accent-text);
  }
  .info-note {
    margin: var(--space-xs) 0 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .aside-block {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-default);
  }
  .aside-eyebrow {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .lang-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
  }
  .lang-list li {
    font-size: 0.9375rem;
    color: var(--text-primary);
    padding-inline-end: var(--space-sm);
    border-inline-end: 1px solid var(--border-default);
  }
  .lang-list li:last-child {
    border-inline-end: 0;
    padding-inline-end: 0;
  }

  .coverage-dark {
    max-width: 48rem;
  }
  .coverage-title {
    margin: 0 0 var(--space-md);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--text-on-dark);
  }
  .coverage-zones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
  }
  .coverage-zones li {
    font-size: 1rem;
    color: var(--text-on-dark);
    padding-inline-end: var(--space-md);
    border-inline-end: 1px solid var(--border-default);
  }
  .coverage-zones li:last-child {
    border-inline-end: 0;
    padding-inline-end: 0;
  }
  .coverage-note {
    margin: var(--space-md) 0 0;
    font-size: 0.9375rem;
    color: var(--text-on-dark-muted);
  }
</style>
