---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import SectionHead from "../components/SectionHead.astro";
import VisitReportDemo from "../components/VisitReportDemo.astro";
import VideoProof from "../components/VideoProof.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";

const reportBenefits = [
  {
    icon: "clipboard",
    title: "Una revisión comprensible",
    text: "Cada punto indica qué se ha observado y si necesita seguimiento.",
  },
  {
    icon: "video",
    title: "Evidencia con contexto",
    text: "Con tu consentimiento, la visita queda documentada en vídeo continuo y sin audio.",
  },
  {
    icon: "users",
    title: "Una persona responsable",
    text: "El informe identifica quién ha realizado la visita y quién sigue cada decisión.",
  },
];
---

<Base
  title="El informe de visita — HappyHomes"
  description="Conoce el informe que recibirás después de cada visita: revisión, observaciones y evidencia en vídeo autorizado o fotografías fechadas."
>
  <Hero
    eyebrow="El informe"
    title="Después de cada visita, sabes cómo queda tu casa."
    lead="Te contamos qué hemos revisado, qué hemos observado y si necesitamos una decisión por tu parte. Con evidencia clara y una persona al otro lado."
    primaryCta={{ label: "Comprobar disponibilidad", href: "/contacto" }}
    secondaryCta={{ label: "Ver los ejemplos", href: "#informe-video" }}
  />

  <Section>
    <div class="benefits">
      {reportBenefits.map((benefit) => (
        <article data-reveal>
          <Icon name={benefit.icon} size={24} />
          <h2>{benefit.title}</h2>
          <p>{benefit.text}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section>
    <div id="informe-video" class="report-section">
      <SectionHead
        eyebrow="Con consentimiento"
        heading="Informe con vídeo"
        lead="La grabación completa la trazabilidad del informe. La propuesta es continua, vertical y sin audio, con eliminación como máximo 15 días después de entregar el informe."
      />
      <div class="report-demo" data-reveal>
        <VisitReportDemo evidenceMode="video" />
      </div>
    </div>
  </Section>

  <Section>
    <div id="informe-fotos" class="report-section">
      <SectionHead
        eyebrow="Alternativa sin grabación"
        heading="Informe con fotografías"
        lead="Si prefieres no autorizar vídeo, documentamos la visita mediante fotografías fechadas. El protocolo, las observaciones y el seguimiento mantienen la misma estructura."
      />
      <div class="report-demo" data-reveal>
        <VisitReportDemo evidenceMode="photos" />
      </div>
    </div>
  </Section>

  <VideoProof ctaLabel="Volver al informe con vídeo" ctaHref="#informe-video" />

  <Section>
    <div class="scope" data-reveal>
      <div>
        <p class="scope-kicker">Alcance claro</p>
        <h2>Observamos, documentamos y te lo explicamos.</h2>
      </div>
      <div class="scope-copy">
        <p>
          La visita es visual y preventiva. El informe describe lo que resulta
          observable durante la revisión y diferencia hechos, actuaciones
          autorizadas y decisiones pendientes.
        </p>
        <p>
          No es una inspección técnica, una certificación de instalaciones, un
          servicio de seguridad ni una garantía sobre lo que pueda ocurrir entre
          visitas.
        </p>
      </div>
    </div>
  </Section>

  <CtaBand
    tone="cream"
    align="center"
    heading="¿Quieres saber si podemos cuidar de tu casa?"
    lead="Cuéntanos el municipio y el tipo de vivienda. Te confirmamos disponibilidad y condiciones para tu dirección."
    ctaLabel="Comprobar disponibilidad"
    ctaHref="/contacto"
    secondaryLabel="Ver servicios"
    secondaryHref="/servicios"
  />
</Base>

<style>
  .benefits {
    display: grid;
    gap: var(--space-lg);
  }

  .benefits article {
    min-width: 0;
    padding: var(--space-lg);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--bg-card);
  }

  .benefits :global(.icon) {
    color: var(--accent-text);
  }

  .benefits h2 {
    margin-top: var(--space-md);
    font-size: 1.5rem;
  }

  .benefits p {
    margin: var(--space-sm) 0 0;
    color: var(--text-muted);
  }

  .report-section {
    scroll-margin-top: 5rem;
  }

  .report-demo {
    margin-top: var(--space-2xl);
  }

  .scope {
    display: grid;
    gap: var(--space-xl);
  }

  .scope-kicker {
    margin: 0 0 var(--space-sm);
    color: var(--accent-text);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .scope h2 {
    max-width: 18ch;
  }

  .scope-copy p {
    color: var(--text-muted);
  }

  .scope-copy p:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 768px) {
    .benefits {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .scope {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: var(--space-3xl);
      align-items: start;
    }
  }
</style>
