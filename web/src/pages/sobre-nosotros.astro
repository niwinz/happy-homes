---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import FeatureList from "../components/FeatureList.astro";
import Coverage from "../components/Coverage.astro";
import CtaBand from "../components/CtaBand.astro";
import Section from "../components/Section.astro";
import { coverageAreas, coverageNote } from "../data/product";

const values = [
  {
    icon: "heart",
    title: "Tranquilidad",
    text: "El núcleo de lo que hacemos. Queremos que no tengas que pensar en tu casa.",
  },
  {
    icon: "shield",
    title: "Confianza",
    text: "Accedemos a tu casa. Por eso cada visita genera un informe y, con tu consentimiento, una grabación continua y sin audio.",
  },
  {
    icon: "key",
    title: "Discreción",
    text: "Tus datos, tu propiedad, tu rutina. Nunca hablamos de un cliente a otro.",
  },
  {
    icon: "sparkles",
    title: "Proactividad",
    text: "Comunicamos los cambios visibles, explicamos su prioridad y proponemos el siguiente paso.",
  },
  {
    icon: "users",
    title: "Cercanía",
    text: "Trato directo. Una persona real, no un call center. A la que puedes llamar directamente.",
  },
];

---

<Base
  title="Sobre nosotros — HappyHomes"
  description="HappyHomes nace de nuestra propia experiencia como propietarios. Conoce la historia y el equipo detrás del servicio."
>
  <Hero
    eyebrow="Sobre nosotros"
    title="Somos propietarios como tú."
    lead="HappyHomes nace de nuestra propia experiencia. Los dos socios tenemos segunda residencia en el Alt Empordà. No pudimos encontrar este servicio. Así que lo creamos."
    primaryCta={{ label: "Comprobar disponibilidad", href: "/contacto" }}
    illustration="house"
  />

  <Section>
    <div class="story" data-reveal>
      <div class="story-eyebrow">Cómo lo hacemos</div>
      <div class="story-body">
        <p>
          Cada casa tiene un Responsable de Casa: una referencia estable que
          conoce su ficha, sigue las visitas y mantiene la comunicación contigo.
        </p>
        <p>
          Si hace falta una sustitución, te indicamos quién accederá y queda
          registrada. Cuando se necesita un especialista, podemos coordinarlo con
          tu autorización y con el alcance y el coste explicados por adelantado.
        </p>
      </div>
    </div>
  </Section>

  <FeatureList
    eyebrow="Valores"
    heading="Cinco principios que no negociamos."
    lead="No son una decoración de web. Son la forma en que trabajamos cada día."
    features={values}
    columns={3}
    tone="cream"
  />

  <Section>
    <div class="coverage-wrap" data-reveal>
      <Coverage zones={coverageAreas} note={coverageNote} />
    </div>
  </Section>

  <CtaBand
    heading="¿Podemos cuidar de tu casa?"
    lead="Cuéntanos el municipio y el tipo de vivienda. Te confirmamos con honestidad si podemos ayudarte."
    ctaLabel="Comprobar disponibilidad"
    ctaHref="/contacto"
  />
</Base>

<style>
  .story {
    display: grid;
    gap: var(--space-2xl);
    max-width: 56rem;
  }
  .story-eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .story-body p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-primary);
    max-width: 60ch;
  }
  .story-body p + p {
    margin-top: var(--space-md);
  }
  @media (min-width: 768px) {
    .story {
      grid-template-columns: 0.4fr 1.6fr;
      gap: var(--space-2xl);
    }
  }
  .coverage-wrap {
    max-width: 48rem;
  }
</style>
