---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import VisitReportDemo from "../components/VisitReportDemo.astro";
import HowItWorks from "../components/HowItWorks.astro";
import PlanGrid from "../components/PlanGrid.astro";
import ExtrasSection from "../components/ExtrasSection.astro";
import ProtocolOverview from "../components/ProtocolOverview.astro";
import FeatureList from "../components/FeatureList.astro";
import Coverage from "../components/Coverage.astro";
import Languages from "../components/Languages.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import CtaBand from "../components/CtaBand.astro";
import Section from "../components/Section.astro";
import SectionHead from "../components/SectionHead.astro";
import Button from "../components/Button.astro";
import {
  coverageAreas,
  coverageNote,
  homeFaqItems,
  oneOffExtras,
  plans,
  processSteps,
  protocolAreas,
  recurringExtras,
  serviceLanguages,
} from "../data/product";

const features = [
  {
    icon: "users",
    title: "Una referencia estable",
    text: "Tu Responsable de Casa conoce la ficha y el contexto de tu vivienda. Si necesita apoyo, la sustitución se identifica y registra.",
  },
  {
    icon: "clipboard",
    title: "Hechos antes que promesas",
    text: "El informe separa lo observado, la actuación autorizada y lo que necesita una decisión por tu parte.",
  },
  {
    icon: "shield",
    title: "Límites claros",
    text: "La visita es visual y preventiva. Los trabajos técnicos, materiales y profesionales se acuerdan y presupuestan aparte.",
  },
];
---

<Base
  title="HappyHomes — Tu casa cuidada también cuando estás lejos"
  description="Cuidado presencial y documentado de segundas residencias en la Costa Brava, el Alt Empordà y el área de Olot."
>
  <Hero
    variant="home"
    eyebrow="Costa Brava · Alt Empordà · Área de Olot"
    title="Tu casa cuidada también cuando estás lejos."
    lead="Una persona de referencia pasa, sigue un protocolo acordado y te envía un informe con lo que ha revisado y observado."
    primaryCta={{ label: "Comprobar disponibilidad", href: "/contacto" }}
    secondaryCta={{ label: "Ver planes", href: "#planes" }}
    backgroundMedia={{
      desktopPosterAvif: "/media/hero/hero-coast-cadaques-v1-desktop.avif",
      desktopPosterJpg: "/media/hero/hero-coast-cadaques-v1-desktop.jpg",
      mobilePosterAvif: "/media/hero/hero-coast-cadaques-v1-mobile.avif",
      mobilePosterJpg: "/media/hero/hero-coast-cadaques-v1-mobile.jpg",
      clips: [
        {
          desktopSrc: "/media/hero/hero-coast-cadaques-v1-desktop.mp4",
          mobileSrc: "/media/hero/hero-coast-cadaques-v1-mobile.mp4",
        },
        {
          desktopSrc: "/media/hero/hero-coast-tossa-v1-desktop.mp4",
          mobileSrc: "/media/hero/hero-coast-tossa-v1-mobile.mp4",
        },
      ],
    }}
    tag="Visita documentada con tu consentimiento"
  />

  <Section>
    <div class="report-preview">
      <div class="report-preview-copy">
        <SectionHead
          eyebrow="El resultado de cada visita"
          heading="No tienes que imaginar cómo está tu casa."
          lead="Este ejemplo enseña qué revisamos, cómo describimos una observación y qué decisión podemos necesitar de ti."
        />
        <div class="report-preview-actions">
          <Button href="/el-informe" variant="primary" size="md">
            Ver los informes de ejemplo
          </Button>
        </div>
      </div>
      <div class="report-preview-demo" data-reveal>
        <VisitReportDemo evidenceMode="video" compact />
      </div>
    </div>
  </Section>

  <HowItWorks
    steps={processSteps}
    heading="De la primera conversación al informe."
    lead="Confirmamos el encaje, acordamos el protocolo y documentamos cada visita."
  />

  <ProtocolOverview areas={protocolAreas} compact />

  <PlanGrid
    id="planes"
    plans={plans}
    eyebrow="Planes"
    heading="Una, dos o cuatro visitas por mes."
    lead="Elige la frecuencia. Nosotros mantenemos la misma forma de revisar, informar y comunicar."
    note="Precios mensuales con IVA incluido y sin cuota de alta. Confirmamos disponibilidad y condiciones para cada dirección."
  />

  <ExtrasSection oneOff={oneOffExtras} recurring={recurringExtras} compact />

  <FeatureList
    eyebrow="Por qué HappyHomes"
    heading="Continuidad, evidencia y límites claros."
    lead="No somos una plataforma anónima ni un servicio de seguridad: somos una referencia local para cuidar y explicar cómo queda tu casa."
    features={features}
    columns={3}
  />

  <Section>
    <div class="duo">
      <Coverage zones={coverageAreas} note={coverageNote} />
      <Languages languages={serviceLanguages} />
    </div>
  </Section>

  <Section>
    <div class="faq-block">
      <div class="faq-head">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="faq-title">Lo que conviene aclarar antes de empezar.</h2>
        <p class="faq-link">
          <Button href="/faq" variant="ghost" size="sm">
            Ver todas las preguntas
          </Button>
        </p>
      </div>
      <FaqAccordion items={homeFaqItems} />
    </div>
  </Section>

  <CtaBand
    heading="¿Podemos cuidar de tu casa?"
    lead="Indícanos el municipio, el tipo de vivienda y la frecuencia que te interesa. Te confirmamos disponibilidad y condiciones."
    ctaLabel="Comprobar disponibilidad"
    ctaHref="/contacto"
    secondaryLabel="Ver cómo funciona"
    secondaryHref="/como-funciona"
  />
</Base>

<style>
  .report-preview {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }
  .report-preview-copy,
  .report-preview-demo {
    min-width: 0;
  }
  .report-preview-actions {
    margin-top: var(--space-xl);
  }
  @media (min-width: 1024px) {
    .report-preview {
      grid-template-columns: minmax(16rem, 0.65fr) minmax(0, 1.35fr);
      gap: var(--space-3xl);
    }
    .report-preview-copy {
      position: sticky;
      top: 6rem;
    }
  }
  .duo {
    display: grid;
    gap: var(--space-lg);
  }
  @media (min-width: 768px) {
    .duo {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
  }
  .faq-block {
    display: grid;
    gap: var(--space-2xl);
  }
  @media (min-width: 768px) {
    .faq-block {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--space-3xl);
      align-items: start;
    }
  }
  .faq-head {
    position: sticky;
    top: 5rem;
  }
  .eyebrow {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .faq-title {
    margin: 0 0 var(--space-lg);
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2rem);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.2;
  }
  .faq-link {
    margin: 0;
  }
</style>
