---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import PlanGrid from "../components/PlanGrid.astro";
import ExtrasSection from "../components/ExtrasSection.astro";
import ProtocolOverview from "../components/ProtocolOverview.astro";
import PlanComparison from "../components/PlanComparison.astro";
import FeatureList from "../components/FeatureList.astro";
import VideoProof from "../components/VideoProof.astro";
import CtaBand from "../components/CtaBand.astro";
import {
  oneOffExtras,
  planComparison,
  plans,
  protocolAreas,
  recurringExtras,
} from "../data/product";

const commonFeatures = [
  {
    icon: "users",
    title: "Responsable de Casa",
    text: "Una persona de referencia conoce la ficha de tu vivienda y sigue cada visita y decisión.",
  },
  {
    icon: "clipboard",
    title: "Protocolo acordado",
    text: "Revisamos la misma matriz visual, adaptada a la casa y a tus autorizaciones.",
  },
  {
    icon: "video",
    title: "Informe con evidencia",
    text: "Después de cada visita recibes el resultado, las observaciones y cualquier decisión pendiente.",
  },
];
---

<Base
  title="Planes y servicios — HappyHomes"
  description="Planes de una, dos o cuatro visitas mensuales, protocolo visual, informe con imágenes y servicios adicionales para tu segunda residencia."
>
  <Hero
    eyebrow="Planes y servicios"
    title="El mismo cuidado, con la frecuencia que tu casa necesita."
    lead="Todas las visitas siguen el protocolo acordado y generan un informe con imágenes. Cambian la frecuencia y la coordinación incluida."
    primaryCta={{ label: "Comprobar disponibilidad", href: "/contacto" }}
    secondaryCta={{ label: "Cómo funciona", href: "/como-funciona" }}
  />

  <PlanGrid
    plans={plans}
    eyebrow="Suscripción"
    heading="Lite, Care o Complete."
    lead="Una, dos o cuatro visitas por mes natural. Care es nuestra propuesta principal para mantener continuidad sin añadir servicios que no necesitas."
    note="Precios mensuales con IVA incluido y sin cuota de alta. La vivienda estándar propuesta es de hasta 150 m² interiores. Confirmamos cobertura, encaje y condiciones antes de activar el servicio."
  />

  <FeatureList
    eyebrow="En todos los planes"
    heading="La frecuencia cambia. El protocolo no se rebaja."
    lead="Cada plan mantiene la misma forma de observar, documentar y comunicar."
    features={commonFeatures}
    columns={3}
  />

  <PlanComparison rows={planComparison} />

  <ExtrasSection oneOff={oneOffExtras} recurring={recurringExtras} />

  <ProtocolOverview areas={protocolAreas} compact />

  <VideoProof
    ctaLabel="Ver los informes de ejemplo"
    ctaHref="/el-informe"
  />

  <CtaBand
    tone="cream"
    align="center"
    heading="¿Qué frecuencia encaja con tu casa?"
    lead="Cuéntanos el municipio, el tipo de vivienda y qué necesitas. Confirmamos disponibilidad y revisamos contigo el plan y los extras."
    ctaLabel="Comprobar disponibilidad"
    ctaHref="/contacto"
    secondaryLabel="Ver cómo funciona"
    secondaryHref="/como-funciona"
  />
</Base>
