#!/usr/bin/env python3
"""Check a commit message against HappyHomes' commit policy.

By default, the script checks HEAD. Use --commit to select another commit or
--message-file to validate a message before creating a commit.

Usage:
  ./scripts/check-commit
  ./scripts/check-commit --commit HEAD~1
  ./scripts/check-commit -c abc1234
  ./scripts/check-commit --message-file /tmp/opencode/commit-message
"""

import argparse
import re
import subprocess
import sys
from pathlib import Path

MAX_LINE_LENGTH = 76
COMMIT_TYPES = ("feat", "fix", "docs", "style", "refactor", "test", "chore")
AI_TRAILER_PREFIX = "AI-assisted-by: "
SUBJECT_PATTERN = re.compile(
    rf"^(?P<type>{'|'.join(COMMIT_TYPES)})"
    r"(?:\((?P<scope>[a-z0-9][a-z0-9._/-]*)\))?: "
    r"(?P<description>[a-z0-9].*)$"
)


def run_git(args):
    """Run a git command and return its result."""
    try:
        return subprocess.run(
            ["git", *args],
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        print("ERROR: git not found. Is it installed?", file=sys.stderr)
        raise SystemExit(1) from None


def get_commit_message(commit_ref):
    """Return the full commit message for a commit reference."""
    result = run_git(["log", "--format=%B", "-n", "1", commit_ref])
    if result.returncode != 0:
        error = result.stderr.strip()
        print(f"ERROR: could not read commit {commit_ref}: {error}", file=sys.stderr)
        raise SystemExit(1)
    if not result.stdout.strip():
        print(f"ERROR: commit {commit_ref} has no message", file=sys.stderr)
        raise SystemExit(1)
    return result.stdout.rstrip("\n")


def get_message_file(path: Path):
    """Return a proposed commit message from a file."""
    try:
        message = path.read_text()
    except OSError as exc:
        print(f"ERROR: could not read message file {path}: {exc}", file=sys.stderr)
        raise SystemExit(1) from None
    if not message.strip():
        print(f"ERROR: message file {path} is empty", file=sys.stderr)
        raise SystemExit(1)
    return message.rstrip("\n")


def check_subject_format(message):
    """Check the conventional commit subject syntax."""
    subject = message.split("\n", 1)[0]
    match = SUBJECT_PATTERN.fullmatch(subject)
    if match is None or subject.endswith("."):
        return False, (
            "Subject must use '<type>(<scope>): <description>' or "
            "'<type>: <description>'.\n"
            f"Allowed types: {', '.join(COMMIT_TYPES)}.\n"
            "Type, scope, and the first description character must be lowercase; "
            "do not end with a period.\n"
            f"Got: {subject!r}"
        )
    return True, None


def check_line_lengths(message):
    """Check the hard line-length limit for every message line."""
    offenders = [
        (line_number, line)
        for line_number, line in enumerate(message.split("\n"), start=1)
        if len(line) > MAX_LINE_LENGTH
    ]
    if not offenders:
        return True, None

    details = "\n".join(
        f"    line {line_number} ({len(line)} chars): {line!r}"
        for line_number, line in offenders
    )
    return False, (
        f"Every commit message line must be {MAX_LINE_LENGTH} characters or fewer.\n"
        f"{details}"
    )


def check_body_blank_line(message):
    """Require a blank line between the subject and any following content."""
    lines = message.split("\n")
    if len(lines) > 1 and lines[1] != "":
        return False, "A blank line must separate the subject from the body or footer."
    return True, None


def check_ai_trailer(message):
    """Reject provider-prefixed AI model names in attribution trailers."""
    trailers = [line for line in message.split("\n") if line.startswith(AI_TRAILER_PREFIX)]
    invalid = [line for line in trailers if "/" in line.removeprefix(AI_TRAILER_PREFIX)]
    if invalid:
        return False, (
            "AI-assisted-by must contain only the model name, without a provider "
            f"prefix. Got: {invalid[0]!r}"
        )
    return True, None


def validate_message(message):
    """Run all machine-checkable commit policy checks."""
    return [
        ("Conventional commit subject", *check_subject_format(message)),
        (f"Every line <= {MAX_LINE_LENGTH} chars", *check_line_lengths(message)),
        ("Blank line after subject", *check_body_blank_line(message)),
        ("Bare AI model name", *check_ai_trailer(message)),
    ]


def main():
    parser = argparse.ArgumentParser(
        description="Check a commit message against HappyHomes commit policy."
    )
    source = parser.add_mutually_exclusive_group()
    source.add_argument(
        "-c",
        "--commit",
        default="HEAD",
        help="Commit to check (default: HEAD)",
    )
    source.add_argument(
        "-F",
        "--message-file",
        type=Path,
        help="Proposed commit message file to check before committing",
    )
    args = parser.parse_args()
    if args.message_file is not None:
        source_name = f"message file {args.message_file}"
        message = get_message_file(args.message_file)
    else:
        source_name = f"commit {args.commit}"
        message = get_commit_message(args.commit)

    print(f"Checking {source_name} ...\n")
    all_ok = True
    for name, ok, error in validate_message(message):
        print(f"  [{'✓' if ok else '✗'}] {name}")
        if not ok:
            all_ok = False
            print(f"         {error}", file=sys.stderr)

    print()
    if all_ok:
        print("All checks passed.")
        return 0

    print("Some checks FAILED. See messages above.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
